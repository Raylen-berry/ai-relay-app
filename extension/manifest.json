{
  "manifest_version": 3,
  "name": "AI 互审 · Relay",
  "description": "多模型互审，并提供数据分析、调研报告和资料问答流程。",
  "version": "0.8.2",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 AI 互审",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*"
      ],
      "js": [
        "adapters.js",
        "editor.js",
        "markdown-source.js",
        "upload.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*"
  },
  "key": "",
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*"
    ]
  }
}
